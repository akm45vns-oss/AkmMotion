PROJECT_NAME="AkmMotion API"
ENVIRONMENT="production"
DEBUG=false
ENABLE_API_DOCS=false

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?ssl=require"
SYNC_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Authentication & Session Hardening
JWT_SECRET="replace-with-a-cryptographically-secure-random-32-char-secret"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
INACTIVITY_TIMEOUT_SECONDS=180

# Redis & Celery Distributed Task Queue
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2

# Concurrency & Capacity Controls
MAX_CONCURRENT_RENDERS_GLOBAL=5
MAX_CONCURRENT_RENDERS_PER_USER=1
MAX_QUEUED_JOBS_PER_USER=3
MAX_SCENES_PER_RENDER=50
MAX_RENDER_DURATION_SECONDS=600
MAX_SIMULTANEOUS_AI_GENERATIONS=3
RENDER_TIMEOUT_SECONDS=600

# Durable Storage Configuration (Cloudflare R2 / AWS S3 / Local)
LOCAL_STORAGE=true
STORAGE_BASE_URL=""
SIGNED_URL_EXPIRATION_SECONDS=3600
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="akmmotion-storage"

# Quota & Cost Controls
MAX_PROJECTS_PER_USER=25
MAX_SCENES_PER_PROJECT=30
MAX_SCRIPT_LENGTH=5000
MAX_DAILY_AI_REQUESTS=50
MAX_DAILY_VIDEO_GENERATIONS=10
MAX_STORAGE_BYTES_PER_USER=1073741824

# External AI Provider Keys
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
REPLICATE_API_TOKEN=""

# Groq API Keys (Round-Robin & Automatic Failover)
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_API_KEY_5=""

# fal.ai Text-to-Video
FAL_KEY=""
FAL_VIDEO_MODEL="fal-ai/kling-video/v1/standard/text-to-video"
FAL_VIDEO_ENABLED=true

# Rendering Executables
FFMPEG_PATH="ffmpeg"
REMOTION_PATH="npx remotion"

