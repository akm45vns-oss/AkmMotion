PROJECT_NAME="AkmMotion API"
ENVIRONMENT="development"
DEBUG=true
ENABLE_API_DOCS=false

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Database
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?ssl=require"
SYNC_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT
JWT_SECRET="your-32-character-secret-key-here"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# AI Provider Keys
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
REPLICATE_API_TOKEN=""
GROQ_API_KEY=""

# fal.ai Text-to-Video
FAL_KEY=""
FAL_VIDEO_MODEL="fal-ai/kling-video/v1/standard/text-to-video"
FAL_VIDEO_ENABLED=true
